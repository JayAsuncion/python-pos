{
	"info": {
		"_postman_id": "auth-rbac-collection-001",
		"name": "Authentication and RBAC",
		"description": "Complete API collection for JWT Authentication and Role-Based Access Control (RBAC) system. Includes login, permission management, role management, and user-role assignments.",
