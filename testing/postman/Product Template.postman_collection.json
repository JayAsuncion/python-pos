    {
      "name": "Get Product Template by ID",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "graphql",
          "graphql": {
            "query": "query GetProductTemplate($productId: Int!) { productTemplate(productId: $productId) { id name code image isActive deletedAt deletedBy } }",
            "variables": "{\n  \"productId\": 1\n}"
          }
        },
        "url": {
          "raw": "{{baseURL}}/graphql",
          "host": [
            "{{baseURL}}"
          ],
          "path": [
            "graphql"
          ]
