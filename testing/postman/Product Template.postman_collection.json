    {
      "name": "Create Product Template",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "graphql",
          "graphql": {
            "query": "mutation CreateProductTemplate($name: String!, $code: String!, $image: String, $isActive: Boolean) { createProductTemplate(name: $name, code: $code, image: $image, isActive: $isActive) { id name code image isActive deletedAt deletedBy } }",
            "variables": "{\n  \"name\": \"Sample Product\",\n  \"code\": \"PROD001\",\n  \"image\": \"https://example.com/image.jpg\",\n  \"isActive\": true\n}"
          }
        },
        "url": {
          "raw": "{{baseURL}}/graphql",
          "host": [
            "{{baseURL}}"
          ],
          "path": [
            "graphql"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Update Product Template",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "graphql",
          "graphql": {
            "query": "mutation UpdateProductTemplate($productId: Int!, $name: String, $code: String, $image: String, $isActive: Boolean) { updateProductTemplate(productId: $productId, name: $name, code: $code, image: $image, isActive: $isActive) { id name code image isActive deletedAt deletedBy } }",
            "variables": "{\n  \"productId\": 1,\n  \"name\": \"Updated Product Name\",\n  \"isActive\": false\n}"
          }
        },
        "url": {
          "raw": "{{baseURL}}/graphql",
          "host": [
            "{{baseURL}}"
          ],
          "path": [
            "graphql"
          ]
        }
      },
      "response": []
    },
