        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "graphql",
          "graphql": {
            "query": "mutation DeleteProductTemplate($productId: Int!, $deletedBy: Int!) { deleteProductTemplate(productId: $productId, deletedBy: $deletedBy) { id name code image isActive deletedAt deletedBy } }",
            "variables": "{\n  \"productId\": 1,\n  \"deletedBy\": 1\n}"
          }
        },
        "url": {
          "raw": "{{baseURL}}/graphql",
          "host": [
            "{{baseURL}}"
