{
  "info": {
    "_postman_id": "1104596b-e639-4536-ba61-1b63848909e5",
    "name": "User",
    "description": "User management API endpoints. Requires authentication via Bearer token. Use the Authentication collection to get a token first.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "8267158"
  },
  "item": [
    {
      "name": "Get All Users",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Response has users array\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.data.users).to.be.an('array');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{accessToken}}",
              "type": "string"
            }
          ]
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "graphql",
          "graphql": {
            "query": "query GetAllUsers {\n  users {\n    id\n    username\n    email\n  }\n}",
            "variables": ""
          }
        },
        "url": {
          "raw": "{{baseUrl}}/graphql",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "graphql"
          ]
        },
        "description": "Get all users. Requires VIEW_USER permission."
      },
      "response": []
    },
    {
      "name": "Get User by ID",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Response has user data\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.data.user).to.exist;",
              "    pm.expect(jsonData.data.user.id).to.exist;",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{accessToken}}",
              "type": "string"
            }
          ]
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "graphql",
          "graphql": {
            "query": "query GetUser($userId: Int!) {\n  user(userId: $userId) {\n    id\n    username\n    email\n  }\n}",
            "variables": "{\n  \"userId\": 1\n}"
          }
        },
        "url": {
          "raw": "{{baseUrl}}/graphql",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "graphql"
          ]
        },
        "description": "Get a single user by ID. Requires VIEW_USER permission."
      },
      "response": []
    },
    {
      "name": "Create User",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"User created successfully\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.data.createUser).to.exist;",
              "    pm.expect(jsonData.data.createUser.id).to.exist;",
              "    pm.expect(jsonData.data.createUser.username).to.exist;",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{accessToken}}",
              "type": "string"
            }
          ]
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "graphql",
          "graphql": {
            "query": "mutation CreateUser($username: String!, $email: String!, $password: String!) {\n  createUser(\n    username: $username\n    email: $email\n    password: $password\n  ) {\n    id\n    username\n    email\n  }\n}",
            "variables": "{\n  \"username\": \"testuser\",\n  \"email\": \"test@example.com\",\n  \"password\": \"password123\"\n}"
          }
        },
        "url": {
          "raw": "{{baseUrl}}/graphql",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "graphql"
          ]
        },
        "description": "Create a new user. Requires CREATE_USER permission."
      },
      "response": []
    },
    {
      "name": "Update User",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"User updated successfully\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.data.updateUser).to.exist;",
              "    pm.expect(jsonData.data.updateUser.updatedAt).to.exist;",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{accessToken}}",
              "type": "string"
            }
          ]
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "graphql",
          "graphql": {
            "query": "mutation UpdateUser($userId: Int!, $email: String) {\n  updateUser(\n    userId: $userId\n    email: $email\n  ) {\n    id\n    username\n    email\n    updatedAt\n    updatedBy\n  }\n}",
            "variables": "{\n  \"userId\": 2,\n  \"email\": \"newemail@example.com\"\n}"
          }
        },
        "url": {
          "raw": "{{baseUrl}}/graphql",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "graphql"
          ]
        },
        "description": "Update an existing user. Requires UPDATE_USER permission."
      },
      "response": []
    },
    {
      "name": "Delete User",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"User deleted successfully\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.data.deleteUser).to.exist;",
              "    pm.expect(jsonData.data.deleteUser.deletedAt).to.exist;",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{accessToken}}",
              "type": "string"
            }
          ]
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "graphql",
          "graphql": {
            "query": "mutation DeleteUser($userId: Int!) {\n  deleteUser(userId: $userId) {\n    id\n    username\n    deletedAt\n    deletedBy\n  }\n}",
            "variables": "{\n  \"userId\": 2\n}"
          }
        },
        "url": {
          "raw": "{{baseUrl}}/graphql",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "graphql"
          ]
        },
        "description": "Soft delete a user. Requires DELETE_USER permission."
      },
      "response": []
    }
